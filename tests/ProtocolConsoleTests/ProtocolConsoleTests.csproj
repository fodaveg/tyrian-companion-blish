<Project Sdk="Microsoft.NET.Sdk">

  <!--
    net8.0, not net472: exercises wire, token, farming freshness/labels and the real incoming
    dispatcher. ClientStubs.cs substitutes the host logger, notification enum and context sampler;
    the controls themselves still require the module's net472/MonoGame/Gw2Sharp graph and Windows QA.
    Linked, not project-referenced: referencing the addon would restore all those dependencies.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TyrianCompanion.BlishBridge.Tests</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../FlatJsonLine.cs" Link="FlatJsonLine.cs" />
    <Compile Include="../../IngameBridgeProtocol.cs" Link="IngameBridgeProtocol.cs" />
    <Compile Include="../../IngameBridgeClient.cs" Link="IngameBridgeClient.cs" />
    <Compile Include="../../FarmingSnapshot.cs" Link="FarmingSnapshot.cs" />
    <Compile Include="../../FarmingPanelText.cs" Link="FarmingPanelText.cs" />
    <Compile Include="../../FarmingChannel.cs" Link="FarmingChannel.cs" />
    <Compile Include="../../TokenGuard.cs" Link="TokenGuard.cs" />
  </ItemGroup>

</Project>
